# Kopieer dit bestand naar .env.local en vul de waarden in vanuit je Supabase-project
# (Supabase dashboard -> Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Geheime sleutel — NOOIT delen, NOOIT in de browser gebruiken.
# Enkel nodig zodat het beheerscherm gezinsaccounts kan aanmaken.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
