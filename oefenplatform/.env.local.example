# Kopieer dit bestand naar .env.local en vul de waarden in.

# Supabase-project (dashboard -> Project Settings -> API). Dit is een NIEUW,
# apart Supabase-project — los van het ouderportaal.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Geheime sleutel — NOOIT delen, NOOIT in de browser gebruiken.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mollie (mollie.com/dashboard -> Ontwikkelaars -> API-sleutels).
# Begin met de "test"-sleutel om de betaling uit te proberen zonder echt geld.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# De volledige URL waarop deze site straks online staat (zonder / op het einde).
# Nodig zodat Mollie na betaling de juiste bezoeker kan terugsturen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
