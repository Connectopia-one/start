   "kop": "Vijf soorten teksten",
   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Soort</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Wat doet de tekst?</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Voorbeelden</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">informatief</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">geeft informatie over een onderwerp</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">krantenartikel, stukje uit een leerboek, mail aan een klant</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">persuasief</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">wil je overtuigen of beïnvloeden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">reclame, campagne tegen te snel rijden, flyer van een fitnesscentrum</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">opiniërend</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">iemand geeft zijn mening (<em>Ich finde ..., Meiner Meinung nach ...</em>)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">recensie, hotelbeoordeling, reactie op sociale media</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">prescriptief</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zegt wat of hoe je iets moet doen</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">recept, instructiefilmpje, schoolreglement, <em>Bitte nicht rauchen!</em></td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">narratief</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">vertelt gebeurtenissen als een verhaal</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">vlog, reisverslag, podcast, getuigenis over een eerste werkdag</td></tr></table>"
    }
   ]
