    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">zin</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">waarom</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">The news <strong>is</strong> good.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">news is ontelbaar, ondanks de s</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">My hair <strong>is</strong> too long.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">hair is in het Engels ontelbaar</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">The police <strong>have</strong> already arrived.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">police is altijd meervoud, ook zonder s</td></tr></table>"
    }
