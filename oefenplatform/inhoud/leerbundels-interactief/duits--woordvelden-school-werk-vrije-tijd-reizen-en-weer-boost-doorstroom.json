   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Beroep</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Wat doet die persoon?</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Koch, die Köchin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">kookt</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Kellner, die Kellnerin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bedient in een restaurant</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Arzt, die Ärztin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verzorgt zieken</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">die Krankenpflegerin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">werkt in het ziekenhuis (das Krankenhaus)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Mechaniker</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">herstelt auto's</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Verkäufer, die Verkäuferin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verkoopt in een winkel</td></tr></table>"
