4ded0;padding:6px 9px;color:#23291f;\">hin und zurück</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">heen en terug</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zu Fuß gehen</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">te voet gaan</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Reisepass, der Koffer</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het paspoort, de koffer</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">das Zelt</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de tent</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">die Jugendherberge</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de jeugdherberg</td></tr></table>"
