ded0;padding:6px 9px;color:#23291f;\">Lies den Text.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">lees de tekst</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">der Lehrer, die Lehrerin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de leraar, de lerares</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Unterstreiche ...</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">onderstreep</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">das Zeugnis</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het rapport</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Übersetze ...</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">vertaal</td></tr></table>"
