  {
   "kop": "Beroepen",
   "blokken": [
    {
     "soort": "kader",
     "html": "<em>Dans ma famille, tout le monde travaille avec les mains. Mon père est électricien, ma mère est infirmière et mon oncle est boulanger. Moi, je voudrais devenir éducateur.</em>"
    },
    {
     "soort": "figuur",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">mannelijk</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">vrouwelijk</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un vendeur</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une vendeuse</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verkoper</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un coiffeur</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une coiffeuse</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">kapper</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un infirmier</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une infirmière</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verpleegkundige</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un boulanger</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une boulangère</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bakker</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un cuisinier</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une cuisinière</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">kok</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un ouvrier</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une ouvrière</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">arbeider</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un médecin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un médecin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">dokter</td></tr></table>",
