   "blokken": [
    {
     "soort": "tekst",
     "html": "Na een <strong>hoeveelheid</strong> komt in het Frans alleen <em>de</em>: <em>un kilo de pommes de terre</em>, <em>500 grammes de carottes</em>, <em>une bouteille de lait</em>, <em>un paquet de pâtes</em>, <em>un litre d'eau</em>, <em>beaucoup de monde</em>, <em>un peu de sel</em>, <em>trop de bruit</em>, <em>assez de places</em> — nooit <em>des</em> of <em>du</em>."
    },
    {
     "soort": "figuur",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Frans</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un kilo, un gramme, un litre</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een kilo, een gram, een liter</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une bouteille, un paquet</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een fles, een pak</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">six œufs</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zes eieren</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un billet, une pièce</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een biljet, een muntstuk</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">payer par carte / en espèces</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">met de kaart / met cash geld betalen</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un ticket</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een kassabon</td></tr></table>",
