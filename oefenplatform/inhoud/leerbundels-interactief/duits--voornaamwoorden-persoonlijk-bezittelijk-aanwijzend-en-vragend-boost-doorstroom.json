    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nominativ</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Akkusativ</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Dativ</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ich</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">mich</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">mir</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ik, mij</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">du</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">dich</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">dir</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">jij, jou</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">er</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ihn</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ihm</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">hij, hem</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ihr</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zij, haar</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">es</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">es</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ihm</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">wir</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">uns</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">uns</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">wij, ons</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ihr</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">euch</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">euch</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">jullie</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sie / Sie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sie / Sie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ihnen / Ihnen</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zij / u</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "<em>Ich liebe dich</em> (Akkusativ). <em>Kannst du mir helfen?</em> (helfen + Dativ). <em>Wie geht es dir?</em> <em>Das gefällt mir.</em>"
    }
   ]
  },
