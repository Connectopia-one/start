  {
   "kop": "Op reis: vervoer en bagage",
   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>plane</strong>, an <strong>aeroplane</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een vliegtuig</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>coach</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een touringcar of autobus voor langere ritten</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>ferry</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een veerboot</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">the <strong>underground</strong>, the tube</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de metro in Londen</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>luggage</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>bagage</strong> (ontelbaar: <em>my luggage is heavy</em>)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>suitcase</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een koffer</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>passport</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een paspoort</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>ticket</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een kaartje</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a <strong>return ticket</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een ticket <strong>heen en terug</strong>; enkel heen is <em>a single</em></td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Een <strong>cottage</strong> is géén vervoermiddel maar een huisje op het platteland, en <em>a frying pan</em> is een braadpan: die hoort in de keuken, niet in je koffer."
    },
    {
     "soort": "kader",
     "html": "Je zegt <strong>niet</strong> <em>I go with the train</em>. In het Engels gebruik je <strong>by</strong>: <em>I go <strong>by</strong> train</em>, <em>by bus</em>, <em>by car</em>, <em>by plane</em>. Te voet is <em>on foot</em>."
    }
   ]
  },
