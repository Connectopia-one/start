   "kop": "Voorzetsels",
   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Altijd Akkusativ</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Altijd Dativ</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Wechselpräpositionen</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">für (voor), ohne (zonder)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">mit (met), bei (bij)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">in, an, auf</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">durch (door), gegen (tegen)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">von (van), zu (naar)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">über, unter, vor</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">um (om)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">aus (uit), nach (naar, na), seit (sinds)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">hinter, neben, zwischen</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Wechselpräpositionen: <strong>waar?</strong> (plaats) → Dativ, <strong>waarheen?</strong> (beweging) → Akkusativ. <em>Ich bin in der Schule.</em> — <em>Ich gehe in die Schule.</em>"
    },
    {
     "soort": "kader",
     "html": "Samentrekkingen: <em>in dem = im, zu dem = zum, zu der = zur, an dem = am, in das = ins</em>. Steden en landen zonder lidwoord: <em>nach Berlin, nach Spanien</em>; maar <em>in die Schweiz</em>."
    }
   ]
  },
