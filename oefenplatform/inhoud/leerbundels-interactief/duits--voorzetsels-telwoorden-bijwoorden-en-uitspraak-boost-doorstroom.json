     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Getal</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Duits</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Getal</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Duits</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">12</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zwölf</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">21</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">einundzwanzig</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">16</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sechzehn</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">30</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">dreißig</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">17</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">siebzehn</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">100</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">hundert</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">20</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zwanzig</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">1 000</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">tausend</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">1999</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">neunzehnhundertneunundneunzig</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">2026</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zweitausendsechsundzwanzig</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Rangtelwoorden: <em>der erste, zweite, dritte, vierte, siebte</em>, vanaf 20 met -ste: <em>der zwanzigste</em>. Datum: <em>am 3. Mai</em> (am dritten Mai). <em>Ich habe am 12. Juni Geburtstag.</em>"
    }
   ]
