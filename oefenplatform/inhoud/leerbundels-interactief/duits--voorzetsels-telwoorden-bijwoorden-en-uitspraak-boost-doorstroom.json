   "kop": "Klanken en spelling",
   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Schrijf je</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Klinkt als</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Voorbeeld</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ei</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">aai</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">mein, Eis</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ie (lang)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Liebe, spielen</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">eu, äu</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">oi</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">heute, Häuser</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ü</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">uu (Nederlandse u)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Tür, müde</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ö</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">eu</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">schön, hören</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ä</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">è</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Mädchen</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sch</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sj</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Schule</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">st, sp aan het begin</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sjt, sjp</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Straße, Sport</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ch na a, o, u</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zachte g-klank</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Buch, acht</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">z</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ts</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Zeit, zehn</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">w</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Nederlandse w als in wat</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Wasser</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">v</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">f</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Vater, viel</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Na een lange klinker of een tweeklank schrijf je <em>ß</em>: <em>die Straße, heißen</em>. Na een korte klinker <em>ss</em>: <em>der Fluss, essen</em>. Alle zelfstandige naamwoorden krijgen een hoofdletter, ook <em>Sie</em> (u)."
    },
    {
     "soort": "kader",
     "html": "<p><strong>Luidop oefenen.</strong> Lees de voorbeeldwoorden uit de klankentabel hardop. Let vooral op ei en ie.</p>"
    }
   ]
