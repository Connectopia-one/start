y=\"IBM Plex Sans,sans-serif\" font-size=\"9.5\" fill=\"#6b7260\">115</text><text x=\"291.2\" y=\"215.0\" text-anchor=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"9\" fill=\"#6b7260\">μ+σ</text><line x1=\"343.5\" y1=\"184\" x2=\"343.5\" y2=\"189\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"343.5\" y=\"202.0\" text-anchor=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"9.5\" fill=\"#6b7260\">130</text><text x=\"343.5\" y=\"215.0\" text-anchor=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"9\" fill=\"#6b7260\">μ+2σ</text><line x1=\"239.0\" y1=\"26.0\" x2=\"239.0\" y2=\"184\" stroke=\"#c17f2b\" stroke-width=\"1.6\" stroke-dasharray=\"4 3\"/><line x1=\"186.8\" y1=\"88.2\" x2=\"186.8\" y2=\"184\" stroke=\"#234539\" stroke-width=\"1.8\"/><text x=\"181.8\" y=\"83.2\" text-anchor=\"end\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#234539\">85</text><line x1=\"291.2\" y1=\"88.2\" x2=\"291.2\" y2=\"184\" stroke=\"#234539\" stroke-width=\"1.8\"/><text x=\"296.2\" y=\"83.2\" text-anchor=\"start\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#234539\">115</text><text x=\"239.0\" y=\"170.0\" text-anchor=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#234539\">68,3 %</text></svg>",
     "onderschrift": "\\(N(100,15)\\): ongeveer \\(68\\%\\) ligt tussen \\(85\\) en \\(115\\)."
    },
    {
     "soort": "tekst",
     "html": "In <strong>\\(N(\\mu,\\sigma)\\)</strong> is \\(\\mu\\) het <strong>gemiddelde</strong> en \\(\\sigma\\) de <strong>standaardafwijking</strong> van de populatie. De Gausskromme is de <strong>dichtheidsfunctie</strong>: een klok, symmetrisch rond \\(\\mu\\). De top ligt boven het gemiddelde, dus bij \\(N(170,8)\\) boven \\(170\\). De helft van de waarden ligt onder het gemiddelde."
    },
    {
     "soort": "kader",
     "html": "<ul><li>De oppervlakte onder de kromme is altijd \\(1\\).</li><li>Grotere \\(\\sigma\\): de kromme wordt <strong>breder en lager</strong>. \\(N(50,2)\\) is hoger dan \\(N(50,4)\\).</li><li>Ander \\(\\mu\\), zelfde \\(\\sigma\\): zelfde vorm, maar verschoven.</li><li>Zelfde gemiddelde is dus niet genoeg voor dezelfde kromme. Klas A \\(N(65,5)\\) en klas B \\(N(65,15)\\): zelfde gemiddelde, maar in B liggen de punten veel verder uit elkaar.</li><li>Een standaardafwijking is nooit negatief.</li></ul>"
    }
   ]
  },
  {
   "kop": "Wanneer past het model?",
   "blokken": [
    {
     "soort": "tekst",
     "html": "Als het <strong>histogram ongeveer klokvormig en symmetrisch</strong> is. Niet bij inkomens (lange staart naar rechts), en niet bij een histogram met twee toppen."
    },
    {
     "soort": "tekst",
     "html": "Een steekproef heeft gemiddelde \\(\\bar{x}\\) en standaardafwijking \\(s\\). Geeft een app \\(\\bar{x}=172{,}4\\) cm en \\(s=6{,}9\\) cm bij een klokvormig histogram, dan kies je het model \\(N(172{,}4;\\ 6{,}9)\\)."
    }
   ]
  },
  {
   "kop": "De vuistregels",
   "blokken": [
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">interval</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">deel van de waarden</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">bij \\(N(100,15)\\)</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(\\mu-\\sigma\\) tot \\(\\mu+\\sigma\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ongeveer \\(68\\%\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(85\\) tot \\(115\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(\\mu-2\\sigma\\) tot \\(\\mu+2\\sigma\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ongeveer \\(95\\%\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(70\\) tot \\(130\\)</td></tr></table>"
    },
    {
     "soort": "kader",
     "html": "<p>Met de symmetrie vind je ook de staarten:</p><ul><li>\\(P(X>100)=50\\%\\).</li><li>\\(P(X<85)\\approx\\frac{1-0{,}68}{2}=0{,}16\\).</li><li>\\(P(X>130)\\approx\\frac{1-0{,}95}{2}=0{,}025\\).</li><li>Toets \\(N(60,10)\\) en Lotte haalt \\(80=\\mu+2\\sigma\\): ze zit bij ongeveer de beste \\(2{,}5\\%\\).</li></ul>"
    }
   ]
  },
  {
   "kop": "Kansen met een rekenapp",
   "blokken": [
    {
     "soort": "tekst",
     "html": "\\(P(X<a)\\) is de <strong>oppervlakte onder de kromme links van \\(a\\)</strong>. Je geeft in: de grens \\(a\\), het gemiddelde \\(\\mu\\) en de standaardafwijking \\(\\sigma\\). De oppervlakte tussen \\(a\\) en \\(b\\) is ongeveer de relatieve frequentie van waarden tussen \\(a\\) en \\(b\\)."
    },
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">opgave</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">uitkomst</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">koffie \\(N(500,4)\\): \\(P(X<492)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(\\approx 0{,}0228\\): ongeveer \\(2{,}3\\%\\) weegt minder dan \\(492\\) g; bij \\(10\\,000\\) pakken zo'n \\(228\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(P(X>492)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(1-0{,}0228=0{,}9772\\), want \\(P(X>a)=1-P(X<a)\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">flessen \\(N(1000,5)\\): \\(P(990<X<1010)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(1-2\\cdot 0{,}0228=0{,}9544\\); \\(P(X>1010)\\) is even groot als \\(P(X<990)\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">mannen \\(N(180,7)\\), deur \\(201\\) cm</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(201=\\mu+3\\sigma\\): ongeveer \\(0{,}15\\%\\) is groter</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(P(173<X<194)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">van \\(\\mu-\\sigma\\) tot \\(\\mu+2\\sigma\\): \\(0{,}34+0{,}475\\approx 0{,}815\\)</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Omgekeerd: het gewicht waaronder \\(10\\%\\) van de pakken ligt, is de waarde \\(a\\) met \\(P(X<a)=0{,}10\\). De app geeft \\(a\\approx 494{,}9\\): \\(10\\%\\) weegt minder dan ongeveer \\(494{,}9\\) g."
    },
    {
     "soort": "weetje",
     "html": "De kans op precies één waarde, zoals \\(P(X=500)\\), is \\(0\\): een kans is een oppervlakte, en een lijn heeft geen oppervlakte. De hoogte van de kromme is dus geen kans."
    }
   ]
  }
 ],
 "onthoud": [
  "\\(N(\\mu,\\sigma)\\): klok rond het gemiddelde \\(\\mu\\); grotere \\(\\sigma\\) = breder en lager.",
  "Oppervlakte onder de kromme = 1; de helft ligt onder het gemiddelde.",
  "\\(68\\%\\) binnen \\(\\mu\\pm\\sigma\\), \\(95\\%\\) binnen \\(\\mu\\pm 2\\sigma\\).",
  "\\(P(X<a)\\) = oppervlakte links van \\(a\\); \\(P(X>a)=1-P(X<a)\\).",
  "Enkel geschikt bij een klokvormig, symmetrisch histogram."
 ]
