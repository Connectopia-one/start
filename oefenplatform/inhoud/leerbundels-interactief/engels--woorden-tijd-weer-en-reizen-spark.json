ans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">1</text><line x1=\"119.6\" y1=\"44.5\" x2=\"125.7\" y2=\"41.0\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"109.2\" y=\"50.5\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">2</text><line x1=\"127.0\" y1=\"72.0\" x2=\"134.0\" y2=\"72.0\" stroke=\"#6b7260\" stroke-width=\"2.2\"/><text x=\"115.0\" y=\"72.0\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">3</text><line x1=\"119.6\" y1=\"99.5\" x2=\"125.7\" y2=\"103.0\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"109.2\" y=\"93.5\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">4</text><line x1=\"99.5\" y1=\"119.6\" x2=\"103.0\" y2=\"125.7\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"93.5\" y=\"109.2\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">5</text><line x1=\"72.0\" y1=\"127.0\" x2=\"72.0\" y2=\"134.0\" stroke=\"#6b7260\" stroke-width=\"2.2\"/><text x=\"72.0\" y=\"115.0\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">6</text><line x1=\"44.5\" y1=\"119.6\" x2=\"41.0\" y2=\"125.7\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"50.5\" y=\"109.2\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">7</text><line x1=\"24.4\" y1=\"99.5\" x2=\"18.3\" y2=\"103.0\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"34.8\" y=\"93.5\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">8</text><line x1=\"17.0\" y1=\"72.0\" x2=\"10.0\" y2=\"72.0\" stroke=\"#6b7260\" stroke-width=\"2.2\"/><text x=\"29.0\" y=\"72.0\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">9</text><line x1=\"24.4\" y1=\"44.5\" x2=\"18.3\" y2=\"41.0\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"34.8\" y=\"50.5\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">10</text><line x1=\"44.5\" y1=\"24.4\" x2=\"41.0\" y2=\"18.3\" stroke=\"#6b7260\" stroke-width=\"1.2\"/><text x=\"50.5\" y=\"34.8\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" fill=\"#6b7260\">11</text><line x1=\"72\" y1=\"72\" x2=\"49.4\" y2=\"94.6\" stroke=\"#234539\" stroke-width=\"4.5\" stroke-linecap=\"round\"/><line x1=\"72\" y1=\"72\" x2=\"72.0\" y2=\"120.0\" stroke=\"#c17f2b\" stroke-width=\"3\" stroke-linecap=\"round\"/><circle cx=\"72\" cy=\"72\" r=\"3.5\" fill=\"#234539\"/></svg></div></div>",
     "onderschrift": "a quarter past eight — ten to six — half past seven."
    },
    {
     "soort": "tekst",
     "html": "<strong>Past</strong> is erover, <strong>to</strong> is ervoor. <em>A quarter past eight</em> is 8.15 uur, <em>a quarter to eight</em> is 7.45 uur, <em>ten to six</em> is 5.50 uur."
    },
    {
     "soort": "kader",
     "html": "<strong>De grootste valstrik van allemaal.</strong> <em>Half past seven</em> is <strong>half acht</strong>, niet half zeven. Het Engels telt vanaf het uur dat <em>geweest</em> is, het Nederlands naar het uur dat <em>komt</em>. Wie dat verwart, staat een uur te vroeg of te laat."
    },
    {
     "soort": "tekst",
     "html": "<em>Noon</em> of <em>midday</em> is de middag, 12 uur. <em>Midnight</em> is middernacht. <em>A.m.</em> staat voor <em>ante meridiem</em> (vóór de middag), <em>p.m.</em> voor <em>post meridiem</em> (erna). <em>The film starts at 7 p.m.</em> is dus 's avonds."
    }
   ]
  },
  {
   "kop": "Dagen, maanden en seizoenen",
   "blokken": [
    {
     "soort": "figuur",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">dagen</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">maanden</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">seizoenen</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Monday, Tuesday, Wednesday</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">January, February, March</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">spring (lente)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Thursday, Friday</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">April, May, June</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">summer (zomer)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Saturday, Sunday</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">July, August, September</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">autumn (Brits) / fall (Amerikaans)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">October, November, December</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">winter</td></tr></table>",
     "onderschrift": "In Wednesday spreek je de d niet uit: 'wensdee'."
    },
    {
     "soort": "tekst",
     "html": "Dagen en maanden krijgen in het Engels een <strong>hoofdletter</strong>. In het Nederlands schrijven we die klein; dat verschil kost punten bij het schrijven."
    }
   ]
  },
  {
   "kop": "Getallen, maten en hoeveelheden",
   "blokken": [
    {
     "soort": "figuur",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">soort</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">voorbeelden</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">hoofdtelwoorden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">one, two, ten, fifteen, twenty-four, a hundred, a thousand, a million</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">rangtelwoorden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">first, second, third, fourth, fifth, twelfth, twentieth</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">hoeveelheden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a dozen (twaalf), a few, a little, much, many, a lot of</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">maten</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">kilos, miles (1 mile ≈ 1,6 km), degrees (graden)</td></tr></table>",
     "onderschrift": "Bij een datum gebruik je een rangtelwoord: the third of May, the fifth of June."
    },
    {
     "soort": "tekst",
     "html": "<strong>A few of a little?</strong> <em>A few</em> gebruik je bij dingen die je kan tellen (<em>a few eggs</em>), <em>a little</em> bij ontelbare (<em>a little milk</em>, <em>a little time</em>). Zo ook: <em>many books</em>, maar <em>much water</em> en <em>a lot of water</em>."
    },
    {
     "soort": "tekst",
     "html": "<em>To weigh</em> is wegen. <em>The box weighs three kilos.</em> In het Verenigd Koninkrijk en de Verenigde Staten meet men afstanden in <em>miles</em>."
    }
   ]
  },
  {
   "kop": "Het weer",
   "blokken": [
    {
     "soort": "figuur",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">sunny, cloudy</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zonnig, bewolkt</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">rainy, a shower</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">regenachtig, een bui</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">windy, foggy, snowy</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">winderig, mistig, met sneeuw</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">freezing</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ijskoud</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">it is raining</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het regent (nu)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">an umbrella</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een paraplu</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">the temperature drops / rises</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de temperatuur daalt / stijgt</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a degree</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een graad</td></tr></table>",
     "onderschrift": "Crowded (druk met mensen) zegt niets over het weer."
    },
    {
     "soort": "tekst",
     "html": "Weer dat op dit moment bezig is, zet je in de present continuous: <em>it is raining</em>. Weer dat vaak gebeurt, in de present simple: <em>it often rains here</em>."
    }
   ]
  },
  {
   "kop": "Reizen en vervoer",
   "blokken": [
    {
     "soort": "figuur",
