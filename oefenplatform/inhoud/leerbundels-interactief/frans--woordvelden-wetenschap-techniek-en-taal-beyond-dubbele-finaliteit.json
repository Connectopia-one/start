   "kop": "Het Frans van België en van Québec",
   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Bij ons of in Québec</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">In Frankrijk</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Betekenis</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>septante</strong> (BE)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">soixante-dix</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">zeventig</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>nonante</strong> (BE)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">quatre-vingt-dix</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">negentig</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>une drache</strong> (BE)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une grosse averse</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een stortregen</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>le dîner</strong> (BE)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">le déjeuner</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het <strong>middagmaal</strong></td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>la fin de semaine</strong> (Québec)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>le week-end</strong></td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het weekend</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "<em>Une baguette</em> is geen Belgisch Frans: dat stokbrood heet overal zo."
