 stroke=\"#2f5d50\" stroke-width=\"2.3\"/><text x=\"282.5\" y=\"24.0\" text-anchor=\"end\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" font-weight=\"600\" fill=\"#2f5d50\">f</text><circle cx=\"95.5\" cy=\"118.0\" r=\"3.6\" fill=\"#23291f\"/><circle cx=\"234.5\" cy=\"118.0\" r=\"3.6\" fill=\"#23291f\"/></svg>",
     "onderschrift": "\\(f(x)<0\\) op \\(]-1,3[\\) en \\(f(x)>0\\) voor \\(x<-1\\) en \\(x>3\\)."
    },
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(x\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(-1\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(3\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f(x)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td></tr></table>"
    }
   ]
  },
  {
   "kop": "Stijgen, dalen en extrema",
   "blokken": [
    {
     "soort": "tekst",
     "html": "Op elk interval van het domein kijk je hoe de functie verloopt:"
    },
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">verloop</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">wat zie je</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">voorbeeld</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">toenemende stijging</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stijgt en wordt steeds steiler</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(x^{2}\\) op \\([0,+\\infty[\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">afnemende stijging</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stijgt, maar steeds trager</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(10, 16, 20, 22, 23\\): de stappen \\(6, 4, 2, 1\\) worden kleiner</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">constante stijging</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stijgt telkens evenveel</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(2, 5, 8, 11\\): telkens \\(+3\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">afnemende daling</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">daalt, maar steeds minder hard</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de waarde van een auto</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">constant</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de grafiek loopt evenwijdig met de \\(x\\)-as</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"></td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Stijgt \\(f\\) tot \\(x=2\\) met \\(f(2)=7\\) en daalt ze daarna, dan bereikt \\(f\\) een <strong>maximum \\(7\\) in \\(x=2\\)</strong>. Een functie die eerst stijgt en dan daalt, heeft dus een maximum, geen minimum. Net voor een maximum zie je vaak een afnemende stijging."
    }
   ]
  },
  {
   "kop": "Symmetrie, asymptoten en periode",
   "blokken": [
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">kenmerk</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">betekenis</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">even functie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">symmetrisch ten opzichte van de \\(y\\)-as, bv. \\(x^{2}\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">oneven functie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">symmetrisch ten opzichte van de <strong>oorsprong</strong> (niet de \\(x\\)-as), bv. \\(x^{3}\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">horizontale asymptoot \\(y=3\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">voor heel grote of heel kleine \\(x\\) komt \\(f(x)\\) steeds dichter bij \\(3\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verticale asymptoot \\(x=-4\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bij \\(f(x)=\\dfrac{5}{x+4}\\): \\(-4\\) ligt niet in het domein</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">periode \\(p\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de grafiek herhaalt zich: met periode \\(5\\) is \\(f(2)=f(7)=f(12)\\)</td></tr></table>"
    },
