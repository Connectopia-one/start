    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a head teacher</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de directeur</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a term</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een trimester</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a pupil</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een leerling</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a subject</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een vak</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">homework</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">huiswerk, altijd enkelvoud</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a degree</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een diploma van de universiteit</td></tr></table>"
