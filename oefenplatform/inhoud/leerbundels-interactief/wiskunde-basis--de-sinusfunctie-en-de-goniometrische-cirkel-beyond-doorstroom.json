    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">kenmerk</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(\\sin x\\)</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bereik</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\([-1,1]\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">periode</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(2\\pi\\): \\(\\sin(x+2\\pi)=\\sin x\\) (en niet \\(\\sin x+2\\pi\\))</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">nulwaarden op \\([0,2\\pi]\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(0\\), \\(\\pi\\) en \\(2\\pi\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">maximum en minimum</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">max \\(1\\) in \\(\\frac{\\pi}{2}\\), min \\(-1\\) in \\(\\frac{3\\pi}{2}\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">dalend</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">op \\(\\left[\\frac{\\pi}{2},\\frac{3\\pi}{2}\\right]\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">symmetrie</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">oneven: symmetrisch ten opzichte van de oorsprong</td></tr></table>"
    }
   ]
