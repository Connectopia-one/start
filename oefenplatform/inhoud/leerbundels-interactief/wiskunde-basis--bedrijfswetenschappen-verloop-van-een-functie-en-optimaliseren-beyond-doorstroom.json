4,136.9 186.3,138.2 187.2,139.5 188.2,140.7 189.1,142.0 190.0,143.2 190.9,144.4 191.9,145.6 192.8,146.7 193.7,147.8 194.7,148.9 195.6,150.0 196.5,151.0 197.4,152.1 198.4,153.0 199.3,154.0 200.2,154.9 201.1,155.8 202.1,156.7 203.0,157.5 203.9,158.3 204.8,159.1 205.8,159.8 206.7,160.5 207.6,161.1 208.6,161.7 209.5,162.3 210.4,162.8 211.3,163.3 212.3,163.7 213.2,164.1 214.1,164.5 215.0,164.8 216.0,165.1 216.9,165.3 217.8,165.4 218.7,165.6 219.7,165.6 220.6,165.7 221.5,165.6 222.5,165.6 223.4,165.4 224.3,165.3 225.2,165.0 226.2,164.7 227.1,164.4 228.0,164.0 228.9,163.5 229.9,163.0 230.8,162.4 231.7,161.8 232.6,161.1 233.6,160.3 234.5,159.5 235.4,158.6 236.4,157.7 237.3,156.7 238.2,155.6 239.1,154.4 240.1,153.2 241.0,151.9 241.9,150.6 242.8,149.2 243.8,147.7 244.7,146.1 245.6,144.5 246.5,142.8 247.5,141.0 248.4,139.1 249.3,137.2 250.3,135.2 251.2,133.1 252.1,130.9 253.0,128.7 254.0,126.4 254.9,123.9 255.8,121.5 256.7,118.9 257.7,116.2 258.6,113.5 259.5,110.7 260.4,107.8 261.4,104.8 262.3,101.7 263.2,98.5 264.2,95.2 265.1,91.9 266.0,88.5 266.9,84.9 267.9,81.3 268.8,77.6 269.7,73.8 270.6,69.8 271.6,65.8 272.5,61.7 273.4,57.5 274.3,53.2 275.3,48.8 276.2,44.3 277.1,39.7 278.1,35.0 279.0,30.2 279.9,25.3 280.8,20.3 281.8,15.2 282.7,10.0 283.6,4.6 284.5,-0.8 285.5,-6.4 286.4,-12.0 287.3,-17.8 288.2,-23.7 289.2,-29.7 290.1,-35.8 291.0,-42.0 292.0,-48.3 292.9,-54.8 293.8,-61.3 294.7,-68.0 295.7,-74.8 296.6,-81.7 297.5,-88.8 298.4,-95.9 299.4,-103.2 300.3,-110.6 301.2,-118.1 302.1,-125.8 303.1,-133.6 304.0,-141.5\" fill=\"none\" stroke=\"#2f5d50\" stroke-width=\"2.3\"/><text x=\"279.8\" y=\"24.0\" text-anchor=\"end\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" font-weight=\"600\" fill=\"#2f5d50\">f</text><circle cx=\"109.4\" cy=\"44.3\" r=\"3.6\" fill=\"#23291f\"/><text x=\"115.4\" y=\"38.3\" text-anchor=\"start\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#23291f\">max</text><circle cx=\"220.6\" cy=\"165.7\" r=\"3.6\" fill=\"#23291f\"/><text x=\"226.6\" y=\"159.7\" text-anchor=\"start\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#23291f\">min</text><circle cx=\"165.0\" cy=\"105.0\" r=\"3.6\" fill=\"#23291f\"/><text x=\"171.0\" y=\"99.0\" text-anchor=\"start\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#23291f\">buigpunt</text></svg>",
     "onderschrift": "\\(f(x)=x^{3}-3x\\): maximum \\(2\\) in \\(x=-1\\), minimum \\(-2\\) in \\(x=1\\)."
    },
    {
     "soort": "tekst",
     "html": "Opgelet: \\(f^{\\prime}(a)=0\\) betekent alleen dat de raaklijn <strong>horizontaal</strong> is. Er is niet altijd een extremum: bij \\(x^{3}\\) is \\(f^{\\prime}(0)=0\\), maar \\(f\\) stijgt gewoon door."
    }
   ]
  },
  {
   "kop": "Hol, bol, buigpunten en de samenvattende tabel",
   "blokken": [
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">teken</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">betekenis</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f^{\\prime\\prime}>0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de grafiek is <strong>hol</strong> (dalparabool-vorm)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f^{\\prime\\prime}<0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de grafiek is <strong>bol</strong> (bergparabool-vorm)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f^{\\prime}>0\\) en \\(f^{\\prime\\prime}<0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\"><strong>afnemende stijging</strong>: stijgt, maar steeds trager</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f^{\\prime}>0\\) en \\(f^{\\prime\\prime}>0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">toenemende stijging</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Een <strong>buigpunt</strong> is een punt waar de grafiek van hol naar bol gaat of omgekeerd: \\(f^{\\prime\\prime}\\) wisselt van teken. \\(f^{\\prime\\prime}(a)=0\\) alleen is niet genoeg. Een buigpunt van \\(f\\) is een top van de grafiek van \\(f^{\\prime}\\). Een tweedegraadsfunctie heeft nooit een buigpunt. Een functie kan stijgen en tegelijk bol zijn."
    },
    {
     "soort": "kader",
     "html": "<p>\\(f(x)=x^{3}-6x^{2}+5\\): \\(f^{\\prime\\prime}(x)=6x-12\\) is nul in \\(x=2\\) en wisselt daar van teken. Buigpunt bij \\(x=2\\); bol voor \\(x<2\\), hol voor \\(x>2\\).</p>"
    },
    {
     "soort": "tekst",
     "html": "<strong>De samenvattende tabel.</strong> In een samenvattende tabel zet je het teken van \\(f^{\\prime}\\) en \\(f^{\\prime\\prime}\\), stijgen of dalen, hol of bol, extrema en buigpunten."
    },
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(x\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(-1\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(0\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(1\\)</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\"></th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f^{\\prime}(x)=3x^{2}-3\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f^{\\prime\\prime}(x)=6x\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(0\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(+\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f(x)=x^{3}-3x\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stijgt, bol</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">max \\(2\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">daalt, bol</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">buigpunt \\((0,0)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">daalt, hol</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">min \\(-2\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stijgt, hol</td></tr></table>"
    },
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">functie</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">afgeleide</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">besluit</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(x^{4}-2x^{2}\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(4x^{3}-4x=4x(x-1)(x+1)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">kandidaat-extrema \\(-1\\), \\(0\\), \\(1\\); in \\(0\\) een <strong>maximum</strong> (\\(f^{\\prime\\prime}(0)=-4\\)), in \\(\\pm 1\\) een minimum</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(2x^{3}-3x^{2}-12x\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(6x^{2}-6x-12=6(x-2)(x+1)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">maximum in \\(-1\\), minimum in \\(2\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(x^{2}-4x+1\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(2x-4\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">minimum \\(-3\\) in \\(x=2\\), bereik \\([-3,+\\infty[\\)</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Op de grafiek van \\(f^{\\prime}\\): een nulpunt met \\(f^{\\prime}\\) positief links en negatief rechts geeft een maximum van \\(f\\)."
    }
   ]
  },
  {
   "kop": "Extremumproblemen",
   "blokken": [
    {
     "soort": "kader",
     "html": "<p><strong>Stappenplan</strong></p><ol><li>Een veranderlijke kiezen en het voorschrift opstellen.</li><li>Het praktisch domein bepalen.</li><li>Afleiden en \\(f^{\\prime}(x)=0\\) oplossen.</li><li>Controleren of het een maximum of minimum is (ook de grenspunten).</li><li>Antwoorden in een zin, met eenheid.</li></ol>"
    },
    {
     "soort": "tekst",
     "html": "Hangt het voorschrift van twee grootheden af, druk dan de ene uit in de andere met het gegeven. Bij een blikje met \\(\\pi r^{2}h=500\\) schrijf je \\(h=\\frac{500}{\\pi r^{2}}\\), zodat de oppervlakte maar van één veranderlijke afhangt. Controleer met de tweede afgeleide: \\(f^{\\prime}(a)=0\\) en \\(f^{\\prime\\prime}(a)<0\\) geeft een <strong>maximum</strong>, \\(f^{\\prime\\prime}(a)>0\\) een <strong>minimum</strong>. Bij een praktisch domein \\([a,b]\\) kan het grootste resultaat ook in een grenspunt liggen."
    },
    {
     "soort": "kader",
