{
 "vak": "Wiskunde basis",
 "titel": "Bedrijfswetenschappen: verloop van een functie en optimaliseren",
 "onder": "Met de eerste en tweede afgeleide het verloop van een functie onderzoeken, en extremumproblemen oplossen.",
 "secties": [
  {
   "kop": "Stijgen, dalen en extrema",
   "blokken": [
    {
     "soort": "tekst",
     "html": "Als \\(f^{\\prime}(x)>0\\) op een interval, dan <strong>stijgt</strong> \\(f\\) daar; als \\(f^{\\prime}(x)<0\\), dan <strong>daalt</strong> \\(f\\). In de tabel van het waardenverloop zie je het teken van \\(f^{\\prime}\\). Gaat het teken van \\(f^{\\prime}\\) in \\(a\\) van \\(+\\) naar \\(-\\), dan heeft \\(f\\) een <strong>relatief maximum</strong>; van \\(-\\) naar \\(+\\) een <strong>relatief minimum</strong>."
    },
