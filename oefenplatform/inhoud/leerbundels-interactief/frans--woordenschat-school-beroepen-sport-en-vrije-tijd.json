   "blokken": [
    {
     "soort": "figuur",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Frans</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un métier</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een beroep — Quel est ton métier ?</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un boulanger</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een bakker</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">une infirmière / un infirmier</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een verpleegster / een verpleger</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un facteur</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een postbode</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un vendeur / une vendeuse</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een verkoper / een verkoopster</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">un médecin, un pharmacien</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een arts, een apotheker</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">travailler dans un bureau</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">op een kantoor werken</td></tr></table>",
     "onderschrift": "Un bureau is zowel het kantoor als het meubel; de zin eromheen beslist."
    }
   ]
