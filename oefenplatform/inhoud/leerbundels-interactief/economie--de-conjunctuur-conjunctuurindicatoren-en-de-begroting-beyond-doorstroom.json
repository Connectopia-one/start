{
 "vak": "Economie",
 "titel": "De conjunctuur, conjunctuurindicatoren en de begroting",
 "onder": "Hoe de economie op en neer golft, hoe je dat vooraf ziet aankomen, en wat het doet met de begroting.",
 "secties": [
  {
   "kop": "Trend en conjunctuur",
   "blokken": [
    {
     "soort": "tekst",
     "html": "De <strong>trend</strong> is <strong>de groeilijn op lange termijn</strong>. De <strong>conjunctuur</strong> zijn <strong>de schommelingen van de economische activiteit rond die trend</strong>."
    },
    {
