     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a draw</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een gelijkspel</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">they beat us two nil</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ze wonnen met twee nul</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a team of a side</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een ploeg</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a referee</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de scheidsrechter</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">a fan</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een supporter</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">the match was called off</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de wedstrijd ging niet door</td></tr></table>"
