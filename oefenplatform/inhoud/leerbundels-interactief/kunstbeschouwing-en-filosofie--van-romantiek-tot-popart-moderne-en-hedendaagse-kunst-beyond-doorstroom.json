  {
   "kop": "De moderne kunst rond 1900",
   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Stroming</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Kern</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Namen</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">postimpressionisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">eigen weg na het impressionisme: kleur, gevoel of vaste vorm</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Van Gogh, Cézanne, Gauguin</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">expressionisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">innerlijk gevoel, felle onnatuurlijke kleuren, vervormde figuren</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Munch (De Schreeuw), Kirchner, Ensor</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">fauvisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">pure felle kleur, los van de werkelijkheid</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Matisse</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">kubisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">een voorwerp van verschillende kanten tegelijk, opgedeeld in vlakken</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Picasso, Braque</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">futurisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">snelheid, techniek en beweging</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Boccioni</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">abstracte kunst</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">geen herkenbare voorwerpen, enkel vorm en kleur</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Kandinsky, Mondriaan</td></tr></table>"
    }
   ]
