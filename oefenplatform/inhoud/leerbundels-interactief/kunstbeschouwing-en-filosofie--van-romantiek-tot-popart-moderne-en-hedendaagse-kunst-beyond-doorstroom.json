   "blokken": [
    {
     "soort": "tekst",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Stroming</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Wat wilde ze?</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Herken je aan</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Namen</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">neoclassicisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">terug naar de rust en de deugd van de oudheid</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">strakke lijnen, heldere compositie, helden uit de oudheid</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Jacques-Louis David</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">romantiek</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">gevoel, verbeelding en de kracht van de natuur</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stormen, ruïnes, dramatisch licht, de eenzame mens</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Delacroix, Friedrich, Turner</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">realisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">het gewone leven tonen zoals het is</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">arbeiders en boeren, zonder mooimakerij</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Courbet, Millet</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">impressionisme</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">de indruk van een moment, het wisselende licht</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">losse zichtbare toetsen, buiten geschilderd, lichte kleuren</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Monet, Renoir, Degas</td></tr></table>"
    }
   ]
