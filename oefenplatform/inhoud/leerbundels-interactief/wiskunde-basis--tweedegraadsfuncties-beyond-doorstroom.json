sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#23291f\">(2, 1)</text><circle cx=\"165.0\" cy=\"86.8\" r=\"3.6\" fill=\"#23291f\"/><text x=\"171.0\" y=\"80.8\" text-anchor=\"start\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#23291f\">(1, 4)</text></svg>",
     "onderschrift": "Grijs \\(x^{2}\\), groen een dalparabool met top \\((2,1)\\), oranje een bergparabool met top \\((1,4)\\)."
    }
   ]
  },
  {
   "kop": "De top vinden",
   "blokken": [
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">vorm</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">top</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">voorbeeld</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f(x)=a(x-p)^{2}+q\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\((p,q)\\), symmetrieas \\(x=p\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(3(x-2)^{2}+5\\): top \\((2,5)\\); \\((x+4)^{2}-1\\): as \\(x=-4\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f(x)=ax^{2}+bx+c\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(x=-\\dfrac{b}{2a}\\), dan \\(y=f(x)\\) invullen</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(x^{2}-6x+2\\): \\(x=3\\), \\(y=9-18+2=-7\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(f(x)=a(x-x_1)(x-x_2)\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">midden tussen de nulwaarden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">nulwaarden \\(-2\\) en \\(6\\): top bij \\(x=2\\)</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Ook uit een tabel lees je de top af, dankzij de symmetrie: \\(f(0)=5\\), \\(f(1)=2\\), \\(f(2)=1\\), \\(f(3)=2\\), \\(f(4)=5\\) geeft top \\((2,1)\\)."
    },
    {
     "soort": "tekst",
     "html": "Van topvorm naar gewone vorm: \\((x-2)^{2}-9=x^{2}-4x+4-9=x^{2}-4x-5\\)."
    }
   ]
  },
  {
   "kop": "Nulwaarden, snijpunt met de y-as en bereik",
   "blokken": [
    {
     "soort": "kader",
     "html": "<ul><li>\\(f(x)=2(x-1)(x+5)\\) heeft nulwaarden \\(1\\) en \\(-5\\).</li><li>\\((x-4)(x-4)\\) heeft twee <strong>samenvallende</strong> nulwaarden: de parabool raakt de \\(x\\)-as, net zoals \\(x^{2}+2x+1=(x+1)^{2}\\).</li><li>\\((x-1)^{2}+2\\) heeft <strong>geen</strong> nulwaarden: de top ligt boven de \\(x\\)-as en het is een dalparabool. Niet elke tweedegraadsfunctie heeft dus twee nulwaarden.</li><li>Het snijpunt met de \\(y\\)-as is \\(c\\): \\(4x^{2}-x+7\\) snijdt de \\(y\\)-as in \\(7\\).</li></ul>"
    },
    {
     "soort": "tekst",
     "html": "Het bereik volgt uit de top: \\(-(x-1)^{2}+4\\) heeft bereik \\(]-\\infty,4]\\). \\((x-3)^{2}\\) daalt tot \\(3\\) en stijgt op \\([3,+\\infty[\\). Op \\([0,+\\infty[\\) stijgt \\(x^{2}\\) toenemend."
    },
    {
     "soort": "tekst",
     "html": "Het tekenverloop van \\((x-1)(x-5)\\): \\(+\\) voor \\(x<1\\), \\(-\\) tussen \\(1\\) en \\(5\\), \\(+\\) voor \\(x>5\\)."
    }
   ]
  },
  {
   "kop": "Transformaties",
   "blokken": [
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">van \\(x^{2}\\) naar</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">transformatie</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(x^{2}+3\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verschuiving \\(3\\) naar <strong>boven</strong></td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\((x-3)^{2}\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verschuiving \\(3\\) naar <strong>rechts</strong></td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\((x+2)^{2}\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verschuiving \\(2\\) naar <strong>links</strong></td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-x^{2}\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">spiegeling rond de \\(x\\)-as</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(4x^{2}\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verticale uitrekking met factor \\(4\\): de \\(x\\)-coördinaat van de top verandert niet</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "\\(2(x+1)^{2}-5\\): verschuiving \\(1\\) naar links, verticale uitrekking met factor \\(2\\), verschuiving \\(5\\) naar beneden. Spiegelen rond de \\(x\\)-as en dan \\(6\\) naar boven geeft \\(-x^{2}+6\\). \\((x-5)^{2}+2\\) heeft haar top \\(5\\) rechts en \\(2\\) boven die van \\(x^{2}\\)."
    }
   ]
  },
  {
   "kop": "Een voorschrift opstellen",
   "blokken": [
    {
     "soort": "kader",
     "html": "<ul><li>Top \\((-1,3)\\), door \\((0,5)\\): \\(f(x)=a(x+1)^{2}+3\\). Invullen: \\(5=a+3\\), dus \\(a=2\\): \\(f(x)=2(x+1)^{2}+3\\).</li><li>Nulwaarden \\(0\\) en \\(8\\), door \\((4,32)\\): \\(f(x)=ax(x-8)\\). Invullen: \\(32=a\\cdot 4\\cdot(-4)\\), dus \\(a=-2\\): \\(f(x)=-2x(x-8)\\).</li></ul>"
    }
   ]
  },
  {
   "kop": "Toepassingen",
   "blokken": [
    {
     "soort": "kader",
     "html": "<p><strong>Een bal:</strong> \\(h(x)=-0{,}05x^{2}+x+2\\).</p><ul><li>Top bij \\(x=-\\dfrac{1}{2\\cdot(-0{,}05)}=10\\) m; hoogte \\(h(10)=-5+10+2=7\\) m.</li><li>Vertrekhoogte: \\(h(0)=2\\) m.</li></ul>"
    },
    {
     "soort": "kader",
     "html": "<p><strong>Een weide:</strong> \\(40\\) m draad, \\(A(x)=x(20-x)\\).</p><ul><li>Praktisch domein \\([0,20]\\).</li><li>Top bij \\(x=10\\): \\(A(10)=100\\ \\text{m}^{2}\\). De grootste weide is een <strong>vierkant</strong> van \\(10\\) bij \\(10\\).</li></ul>"
    },
    {
     "soort": "tekst",
     "html": "<strong>Omzet:</strong> \\(O(p)=-4p^{2}+160p\\) is het grootst bij \\(p=-\\dfrac{160}{2\\cdot(-4)}=20\\) euro."
    }
   ]
  }
 ],
 "onthoud": [
  "\\(a>0\\): dalparabool met minimum; \\(a<0\\): bergparabool met maximum; grotere \\(|a|\\) = steiler.",
  "Top van \\(a(x-p)^{2}+q\\) is \\((p,q)\\); bij \\(ax^{2}+bx+c\\) is \\(x_{top}=-\\dfrac{b}{2a}\\).",
  "De top ligt midden tussen de nulwaarden; het snijpunt met de y-as is c.",
  "\\((x-3)^{2}\\): 3 naar rechts. \\(x^{2}+3\\): 3 naar boven. \\(-x^{2}\\): spiegeling. \\(4x^{2}\\): uitrekking.",
  "Een parabool heeft 0, 1 of 2 nulwaarden.",
  "Optimaliseren: de top geeft het grootste of kleinste resultaat."
 ]
}