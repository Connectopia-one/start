     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Go straight on.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Ga rechtdoor.</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Turn left / turn right.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Sla links / rechts af.</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">It's next to the bakery.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Het is naast de bakker.</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">It's opposite the church.</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Het is tegenover de kerk.</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Excuse me, where is the station?</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">Pardon, waar is het station?</td></tr></table>",
     "onderschrift": ""
    }
   ]
