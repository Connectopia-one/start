     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Engels</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">Nederlands</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">pen</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">pen</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">schoolbag</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">boekentas</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">pencil</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">potlood</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">desk</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bank</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">rubber</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">gom</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">board</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bord</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">ruler</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">lat</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">teacher</td><td style=\"border:1px solid #e4ded0;