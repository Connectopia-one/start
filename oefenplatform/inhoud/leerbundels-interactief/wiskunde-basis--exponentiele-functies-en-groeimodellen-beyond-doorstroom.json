ill=\"none\" stroke=\"#c17f2b\" stroke-width=\"2.3\"/><text x=\"300.0\" y=\"168.5\" text-anchor=\"end\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10.5\" font-weight=\"600\" fill=\"#c17f2b\">(1/2)^x</text><circle cx=\"165.0\" cy=\"155.6\" r=\"3.6\" fill=\"#23291f\"/><text x=\"171.0\" y=\"149.6\" text-anchor=\"start\" font-family=\"IBM Plex Sans,sans-serif\" font-size=\"10\" font-weight=\"600\" fill=\"#23291f\">(0, 1)</text></svg>",
     "onderschrift": "\\(2^{x}\\) stijgt, \\(\\left(\\tfrac{1}{2}\\right)^{x}\\) daalt. Ze snijden elkaar in \\((0,1)\\)."
    },
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">kenmerk</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">\\(f(x)=a^{x}\\) met \\(a>0\\), \\(a\\neq 1\\)</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">vast punt</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\((0,1)\\), want \\(a^{0}=1\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">domein</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(\\mathbb{R}\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">bereik</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(]0,+\\infty[\\): de grafiek snijdt de \\(x\\)-as nooit</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">asymptoot</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">horizontaal: \\(y=0\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">stijgend</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">als \\(a>1\\): toenemende stijging</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">dalend</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">als \\(0<a<1\\): afnemende daling</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "Bij \\(3\\cdot 2^{x}\\) gaat \\(f(x)\\to 0\\) als \\(x\\to-\\infty\\). Gaat de grafiek van \\(a^{x}\\) door \\((1,6)\\), dan is \\(a^{1}=6\\), dus \\(a=6\\)."
    }
   ]
  },
  {
   "kop": "Transformaties",
   "blokken": [
    {
     "soort": "kader",
     "html": "<table style=\"width:100%;border-collapse:collapse;font-family:'IBM Plex Sans',sans-serif;font-size:10.5pt;text-align:left;\"><tr><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">voorschrift</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">wat gebeurt er</th><th style=\"border:1px solid #e4ded0;background:rgba(47,93,80,.09);padding:6px 9px;color:#234539;font-weight:600;text-align:left;\">asymptoot en bereik</th></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(2^{x}+4\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(4\\) naar boven</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(y=4\\); bereik \\(]4,+\\infty[\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(5\\cdot 2^{x}-3\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">uitrekking met factor \\(5\\), \\(3\\) naar beneden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(y=-3\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(-3^{x}\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">spiegeling rond de \\(x\\)-as</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(y=0\\); bereik \\(]-\\infty,0[\\)</td></tr><tr><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(3\\cdot 2^{x}-1\\)</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">verticale uitrekking met factor \\(3\\), \\(1\\) naar beneden</td><td style=\"border:1px solid #e4ded0;padding:6px 9px;color:#23291f;\">\\(y=-1\\)</td></tr></table>"
    },
    {
     "soort": "tekst",
     "html": "\\(-2\\cdot 3^{x}\\) is <strong>dalend</strong>: de spiegeling draait het stijgen om. \\(4\\cdot 3^{x}+2\\) snijdt de \\(y\\)-as in \\(4\\cdot 1+2=6\\)."
    },
    {
     "soort": "tekst",
     "html": "\\(2^{x}+c\\) heeft enkel een nulwaarde als \\(c\\) negatief is: \\(2^{x}+(-8)=0\\) geeft \\(2^{x}=8\\), \\(x=3\\)."
    },
    {
     "soort": "weetje",
     "html": "\\(2\\cdot 5^{x}\\) is niet hetzelfde als \\(10^{x}\\): bij \\(x=2\\) is het eerste \\(50\\), het tweede \\(100\\)."
    }
   ]
  },
  {
   "kop": "Groeifactor",
   "blokken": [
    {
     "soort": "kader",
